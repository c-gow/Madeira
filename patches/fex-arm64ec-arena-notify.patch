diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
index fbaf76f11..05e6f7817 100644
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -1404,6 +1404,31 @@ NTSTATUS ResetToConsistentState(EXCEPTION_RECORD* Exception, CONTEXT* GuestConte
   return STATUS_SUCCESS;
 }
 
+/* iOS-Madeira: memory notifications for FEX's own arena are ignored.
+ *
+ * ntdll hands FEX a private VA band (ios_fex_band_base..ios_fex_band_end,
+ * inclusive; "[fex-arena] ml797 ARENA HANDED OVER") for its heap, thread
+ * states, call-return stacks and JIT buffers. No guest code ever lives there,
+ * so there is nothing for the InvalidationTracker to track or invalidate.
+ *
+ * Passing those notifications through is also a self-deadlock. The tracker
+ * takes IntervalsLock exclusively and then allocates or frees (vector growth
+ * in XIntervals.Insert, the log line's temporary string). When FEX's
+ * allocator commits or decommits a span at that moment, Wine reports it here
+ * on the same thread, the tracker asks for IntervalsLock again, and
+ * std::shared_mutex is not recursive: the thread parks on itself forever,
+ * typically while HandleImageMap registers a DLL during process start. */
+static bool IsFEXArenaRange(const void* Address, SIZE_T Size) {
+  const auto Begin = reinterpret_cast<uintptr_t>(Address);
+  if (!ios_fex_band_base || !ios_fex_band_end || !Begin) {
+    return false;
+  }
+  if (!Size) { // MEM_RELEASE of a whole region: judge by its base
+    return Begin >= ios_fex_band_base && Begin <= ios_fex_band_end;
+  }
+  return Begin >= ios_fex_band_base && Begin - 1 + Size <= ios_fex_band_end && Begin - 1 + Size >= Begin;
+}
+
 /* iOS-port note: previously this took ThreadCreationMutex on the BEFORE
  * call and released it on the AFTER call, holding the lock across the
  * actual memory operation. On Wine-on-iOS that creates an AB-BA deadlock:
@@ -1418,7 +1443,7 @@ NTSTATUS ResetToConsistentState(EXCEPTION_RECORD* Exception, CONTEXT* GuestConte
  * required for its correctness. Drop the BEFORE/AFTER mutex entirely
  * and just call into the tracker directly on AFTER. */
 void NotifyMemoryAlloc(void* Address, SIZE_T Size, ULONG Type, ULONG Prot, BOOL After, NTSTATUS Status) {
-  if (!InvalidationTracker || !GetCPUArea().ThreadState()) {
+  if (!InvalidationTracker || !GetCPUArea().ThreadState() || IsFEXArenaRange(Address, Size)) {
     return;
   }
 
@@ -1431,7 +1456,7 @@ void NotifyMemoryAlloc(void* Address, SIZE_T Size, ULONG Type, ULONG Prot, BOOL
 }
 
 void NotifyMemoryFree(void* Address, SIZE_T Size, ULONG FreeType, BOOL After, NTSTATUS Status) {
-  if (!InvalidationTracker || !GetCPUArea().ThreadState()) {
+  if (!InvalidationTracker || !GetCPUArea().ThreadState() || IsFEXArenaRange(Address, Size)) {
     return;
   }
 
@@ -1443,7 +1468,7 @@ void NotifyMemoryFree(void* Address, SIZE_T Size, ULONG FreeType, BOOL After, NT
 }
 
 void NotifyMemoryProtect(void* Address, SIZE_T Size, ULONG NewProt, BOOL After, NTSTATUS Status) {
-  if (!InvalidationTracker || !GetCPUArea().ThreadState()) {
+  if (!InvalidationTracker || !GetCPUArea().ThreadState() || IsFEXArenaRange(Address, Size)) {
     return;
   }
 
